# Copie para .env.local e preencha seus valores reais
# Não commite .env.local — ele tem segredos

# Claude (análise de vídeos)
ANTHROPIC_API_KEY=sk-ant-...

# Groq (transcriação de áudio como fallback)
GROQ_API_KEY=gsk_...

# Google (Trends na Biblioteca)
YOUTUBE_API_KEY=AIzaSy...

# Pexels (banco de B-roll da aba Viral)
PEXELS_API_KEY=...

# Supabase (banco de dados + auth)
NEXT_PUBLIC_SUPABASE_URL=https://xyz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Chave mestra — ignora RLS. Só em código de servidor, nunca com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Stripe (assinaturas) — detalhes em src/lib/planos/stripe.ts
STRIPE_SECRET_KEY=sk_test_...
# Segredo do endpoint no painel do Stripe. O do `stripe listen` local é outro.
STRIPE_WEBHOOK_SECRET=whsec_...
# Id do PREÇO (price_...), não do produto (prod_...). Recorrente mensal em BRL.
STRIPE_PRICE_CRIADOR=price_...
STRIPE_PRICE_PROFISSIONAL=price_...
STRIPE_PRICE_ESTUDIO=price_...

# Endereço público do site — pra onde o Checkout devolve a pessoa.
# Sem ele caímos no cabeçalho Origin, que quem chama a rota escolhe.
NEXT_PUBLIC_SITE_URL=https://seudominio.com

# FFmpeg (processamento de vídeo)
# Se instalado via PATH, não precisa
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# yt-dlp (download de vídeos)
# Se instalado via PATH, não precisa
# YTDLP_PATH=/usr/bin/yt-dlp

# Modelo de IA (padrão: claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high

# Limites (segundos de vídeo máximo)
MAX_DURACAO_SEGUNDOS=180
